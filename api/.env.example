MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Key presence never enables paid calls. Developer CLIs require --live and
# --confirm-spend. Public inference also requires every owner-approved production
# setting below, an authenticated guest, a signed menu, and private cost controls.
DINETUNED_META_PRODUCTION_ENABLED=false
DINETUNED_META_PRODUCTION_APPROVAL_ID=
DINETUNED_META_PRODUCTION_CAP_USD=
DINETUNED_META_PRODUCTION_MAX_ATTEMPTS=
DINETUNED_META_PRODUCTION_DAILY_PER_GUEST=
# Optional Muse Image illustrations for up to three validated primary Picks.
# Disabled unless separately approved; key presence alone never enables calls.
DINETUNED_MUSE_IMAGE_ENABLED=false
DINETUNED_MUSE_IMAGE_APPROVAL_ID=
DINETUNED_MUSE_IMAGE_CAP_USD=
DINETUNED_MUSE_IMAGE_MAX_IMAGES=
ALLOWED_ORIGINS=http://localhost:3000
# Optional. Only a publishable key is supported; private calls also require the
# user's verified access token. Leave blank to preserve local-only demo mode.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend-only Google Places API (New). Both flags must be explicitly enabled
# by the owner after approving live Google billing. A key alone enables nothing.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_LIVE_APPROVED=false
